# Database Configuration (PostgreSQL / Hosted PostgreSQL such as Supabase / Neon)
# Local Example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerlens
# Hosted Supabase Example (Use Transaction Pooler or Direct URI):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerlens

# JWT Authentication
JWT_SECRET_KEY=generate_a_secure_random_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / Frontend URL
FRONTEND_URL=http://localhost:5173

# Uploads directory
UPLOAD_DIR=uploads

# AI & Job API keys (Optional for auth & core features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_COUNTRY=in
